# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

# Database
# DB_CONNECTION selects the Lucid connection from config/database.ts — no code
# changes are needed to switch drivers, only these env vars.
#
# Option 1) SQLite — zero setup, good for local development.
DB_CONNECTION=sqlite
#
# Option 2) PostgreSQL — local (native install or `docker compose up db`) or
# production. Uncomment DB_CONNECTION=pg below and fill in the connection info.
# DB_CONNECTION=pg
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_DATABASE=ado

# Mail (Resend)
# Used for password reset, magic link, and contact-form emails. Get a key at
# https://resend.com/api-keys — the sandbox address below works without a
# verified domain, but only delivers to the account's own email address.
RESEND_API_KEY=
MAIL_FROM_ADDRESS=onboarding@resend.dev
MAIL_FROM_NAME=Todo

# Rate limiting — applied to login and password-reset requests. "memory" is used
# automatically in tests (see .env.test).
LIMITER_STORE=database

# Social login (Google/GitHub via Ally). Create OAuth apps at
# https://console.cloud.google.com/apis/credentials and
# https://github.com/settings/developers, with callback URLs:
#   ${APP_URL}/oauth/google/callback
#   ${APP_URL}/oauth/github/callback
# Left blank, the app still boots — the buttons just fail to authenticate.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=