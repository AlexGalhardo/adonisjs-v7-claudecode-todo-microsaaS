SESSION_DRIVER=memory

# Tests default to SQLite so the suite never touches the dev/Postgres database and
# needs no external service. Override to `pg` (+ DB_DATABASE=ado_test) to run the
# suite against Postgres instead.
DB_CONNECTION=sqlite

# Rate limiting uses the in-memory store in tests, so limits never leak between
# tests via the database and tests don't need to wait out real time windows.
LIMITER_STORE=memory
