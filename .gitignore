# Dependencies and AdonisJS build
node_modules
build
tmp/*
!tmp/.gitkeep

# Secrets
.env
.env.*
!.env.example
!.env.test

# Frontend assets compiled code
public/assets

# Drizzle Studio schema snapshot (regenerate with `npx drizzle-kit pull`) —
# Lucid owns migrations, this is only a viewer, not worth versioning.
drizzle

# Build tools specific
npm-debug.log
yarn-error.log

# This project uses npm (package-lock.json) exclusively — ignore other lockfiles
# that get created if someone accidentally runs a different package manager.
bun.lock
pnpm-lock.yaml
yarn.lock

# Working directory of the `skills` CLI (npx skills add ...) — the design-guideline
# skills it installed are committed directly under .claude/skills/<name>/ as plain
# files instead (the CLI's own .claude/skills symlinks use absolute paths, which
# break on any other machine, so those were replaced with real copies).
.agents/
skills-lock.json

# Editors specific
.fleet
.idea
.vscode

# Platform specific
.DS_Store
