# @adonisjs/ally@6.3.0 declares a peerOptional dependency on @adonisjs/inertia@^4.2.0,
# but this project uses @adonisjs/inertia@^5.0.1 (the version the ally driver actually
# needs it for — Inertia error sharing — works fine against v5; the peer range is just
# stale upstream). Without this, every `npm install` fails with an unresolvable
# ERESOLVE conflict.
legacy-peer-deps=true
